<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titlu aplicație -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="FocusDesk"
            android:textColor="#1E293B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Smart Office &amp; Study Companion"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Buton pentru acordarea permisiunii Do Not Disturb -->
        <Button
            android:id="@+id/btnDndPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#EF4444"
            android:text="Acordă permisiune Do Not Disturb"
            android:textColor="#FFFFFF" />

        <!-- Card Cronometru (Modul Face Down) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvFocusStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="MOD ACTIV (Telefon ridicat)"
                android:textColor="#0284C7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:text="00:10"
                android:textColor="#0F172A"
                android:textSize="54sp"
                android:textStyle="bold" />

            <!-- Buton oprire alarmă -->
            <Button
                android:id="@+id/btnStopAlarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#DC2626"
                android:text="🔇 Oprește alarma"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

            <!-- Butoane setare durată și sunet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSetDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0284C7"
                    android:text="⏱️ Durată"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSelectSound"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#475569"
                    android:text="🔔 Sunet"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Sunet finalizare: Implicit (Notificare)"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tvHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Așază telefonul cu ecranul în jos pe birou pentru a porni sesiunea de focus."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Buton navigare către Ecranul 2 (Statistici & Istoric) -->
            <Button
                android:id="@+id/btnOpenStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#1E293B"
                android:text="📊 Statistici &amp; Istoric (0 sesiuni)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Card Asistent Lumină (Sănătatea Ochilor) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASISTENT LUMINĂ AMBIENTALĂ"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLuxValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:text="-- lux"
                android:textColor="#0F172A"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLightStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Se monitorizează lumina ambientală..."
                android:textColor="#16A34A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>